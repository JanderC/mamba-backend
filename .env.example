# --- Servidor ---
PORT=4100
NODE_ENV=development
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000

# --- Base de datos ---
# Local (pgAdmin):
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/mamba_bistro
# Neon (producción) — pega el connection string de Neon:
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/mamba_bistro?sslmode=require

# --- Panel administrativo ---
# Clave para firmar las sesiones (mínimo 16 caracteres, inventa una larga y no la compartas)
JWT_SECRET=cambia-esta-clave-larga-y-secreta
JWT_EXPIRA=16h
# Zona horaria del negocio (cortes de jornada y reportes): America/Bogota o America/Caracas
TZ_NEGOCIO=America/Bogota

# --- WhatsApp Cloud API (opcional: envío automático de reservas y recordatorios) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número que recibe las notificaciones (sin +). Si está vacío se usa el de configuracion_local
WHATSAPP_NOTIFY_TO=

# --- Email (opcional, vía Resend https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Mamba Reservas <reservas@tudominio.com>"
EMAIL_NOTIFY_TO=

# --- Instagram (opcional: feed dinámico en la galería) ---
INSTAGRAM_ACCESS_TOKEN=
